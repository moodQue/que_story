{
  "rules": {
    "hunts": {
      ".read": false,
      "$week": {
        "$tid": {
          "$username": {
            ".read": false,
            ".write": "newData.exists() && newData.hasChildren(['kick_username','territory_id','phrase','week','confirmed','timestamp']) && newData.child('kick_username').val() === $username && newData.child('confirmed').val() === false && (!data.exists() || data.child('confirmed').val() !== true)",
            "kick_username": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "territory_id": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "phrase": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "week": {
              ".validate": "newData.isString() || newData.isNumber()"
            },
            "confirmed": {
              ".validate": "newData.isBoolean()"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "codes": {
      ".read": false,
      ".write": false,
      "$sessionId": {
        ".read": true,
        ".write": "!data.exists() && newData.exists() && newData.hasChildren(['phrase','territory','week','created_at','used']) && newData.child('used').val() === false",
        "phrase": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "territory": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "week": {
          ".validate": "newData.isString() || newData.isNumber()"
        },
        "created_at": {
          ".validate": "newData.isNumber()"
        },
        "used": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "completions": {
      ".read": false,
      ".write": false
    },
    "faction_founders": {
      ".read": false,
      ".write": false
    },
    "faction_counters": {
      ".read": false,
      ".write": false
    },
    "daily_scans": {
      "$scanDate": {
        ".indexOn": [
          "captured_at",
          "self_quadrant"
        ],
        "$viewerKey": {
          ".write": "newData.exists() && newData.hasChildren(['source', 'platform', 'viewer_handle', 'scan_date', 'self_quadrant', 'captured_at']) && newData.child('scan_date').val() === $scanDate",
          ".read": false,
          "source": {
            ".validate": "newData.isString() && newData.val().matches(/^(web|instagram_comment|discord)$/)"
          },
          "platform": {
            ".validate": "newData.isString()"
          },
          "platform_user_id": {
            ".validate": "newData.isString()"
          },
          "viewer_handle": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "referrer_network": {
            ".validate": "newData.isString() && newData.val().matches(/^(instagram|youtube|tiktok|discord|x|direct|other)$/)"
          },
          "campaign": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "scan_date": {
            ".validate": "newData.isString()"
          },
          "self_quadrant": {
            ".validate": "newData.isString() && newData.val().matches(/^(LIT|STORM|HOLLOW|STILL)$/)"
          },
          "score_key": {
            ".validate": "newData.isString()"
          },
          "raw_text": {
            ".validate": "newData.isString()"
          },
          "field_territory": {
            ".validate": "newData.isString() || newData.val() === null"
          },
          "field_quadrant": {
            ".validate": "newData.isString() || newData.val() === null"
          },
          "quiz_version": {
            ".validate": "newData.isString() || newData.val() === null"
          },
          "captured_at": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": true
          }
        }
      }
    },
    "territory_views": {
      ".read": false,
      "$date": {
        ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        "$territory": {
          ".validate": "newData.isNumber() && $territory.matches(/^[a-z_]{3,40}$/)",
          ".write": "newData.isNumber() && (data.exists() ? newData.val() === data.val() + 1 : newData.val() === 1)"
        }
      }
    },
    "quiz_assignments": {
      "$sourceMonth": {
        ".indexOn": [
          "completed_at",
          "primary_faction",
          "primary_territory"
        ],
        "$assignmentId": {
          ".write": "newData.exists() && newData.hasChildren(['quiz_id', 'quiz_version', 'source_month', 'primary_faction', 'primary_territory', 'personal_vac', 'answers', 'completed_at']) && newData.child('source_month').val() === $sourceMonth",
          ".read": false,
          "quiz_id": {
            ".validate": "newData.isString()"
          },
          "quiz_version": {
            ".validate": "newData.isString()"
          },
          "source_month": {
            ".validate": "newData.isString()"
          },
          "viewer_handle": {
            ".validate": "newData.isString() || newData.val() === null"
          },
          "primary_faction": {
            ".validate": "newData.isString()"
          },
          "primary_territory": {
            ".validate": "newData.isString()"
          },
          "nearest_vac_territory": {
            ".validate": "newData.isString()"
          },
          "confidence": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
          },
          "personal_vac": {
            ".validate": "newData.hasChildren(['valence', 'arousal', 'control'])",
            "valence": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
            },
            "arousal": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
            },
            "control": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
            }
          },
          "playlist_seed": {
            ".validate": "newData.hasChildren(['target_valence', 'target_energy', 'target_control'])"
          },
          "answers": {
            ".validate": "newData.hasChildren()"
          },
          "completed_at": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": true
          }
        }
      }
    }
  }
}